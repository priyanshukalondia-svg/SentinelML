# ---------------------------------------------------------------------------
# SentinelML — environment configuration
#
# Copy this file to `.env` and adjust as needed. Docker Compose reads
# `.env` automatically from the repo root; for local (non-Docker)
# development, copy it to backend/.env instead (or export these as shell
# environment variables).
# ---------------------------------------------------------------------------

# --- General ---
ENV=development
DEMO_MODE=true

# --- Database (SQLite by default for local dev; Compose overrides this to Postgres) ---
DATABASE_URL=sqlite:///./backend/sentinelml.db

# --- MLflow ---
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=sentinelml-fraud-detector

# --- Storage ---
DATA_DIR=./ml/datasets
MODEL_STORE_DIR=./ml/models
MAX_UPLOAD_SIZE_MB=50

# --- CORS ---
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Monitoring ---
MONITORING_INTERVAL_SECONDS=60

# --- Drift thresholds ---
DRIFT_WARNING_THRESHOLD=0.10
DRIFT_CRITICAL_THRESHOLD=0.25

# --- Promotion rules ---
PROMOTION_METRIC=f1
PROMOTION_MIN_IMPROVEMENT=0.02
PROMOTION_MAX_LATENCY_INCREASE_PCT=10.0

# --- Rollback ---
ROLLBACK_MAX_ERROR_RATE=0.05
ROLLBACK_MIN_HEALTH_SCORE=70

# --- Training ---
TRAINING_TIMEOUT_SECONDS=900
RETRAINING_COOLDOWN_SECONDS=300

# --- Security ---
SECRET_KEY=change-me-in-production
RATE_LIMIT_PREDICT_PER_MINUTE=120
RATE_LIMIT_SIMULATION_PER_MINUTE=10

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws/events
